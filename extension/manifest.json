{
  "manifest_version": 3,
  "name": "Property Listing Collector",
  "version": "0.1.0",
  "description": "Reads the page's own embedded JSON while a person browses, and exports the listings to CSV / XLSX.",
  "permissions": ["storage", "scripting", "downloads", "activeTab"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Property Listing Collector"
  }
}
